# Copia este archivo como .streamlit/secrets.toml (en tu computador)
# o pega su contenido en "Settings → Secrets" de Streamlit Cloud.

OPENAI_API_KEY = "sk-..."

# Mensajes que cada usuario puede enviar por día
MAX_MENSAJES_POR_USUARIO = 20

# Tope total de mensajes por día sumando a todos los usuarios
MAX_MENSAJES_GLOBALES_DIA = 300

# Largo máximo de cada respuesta (en tokens)
MAX_TOKENS_RESPUESTA = 1000
